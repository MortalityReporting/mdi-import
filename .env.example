# Copy values into your deployment environment. Do not commit real values.
INCOMING_API_PATH=/import
INCOMING_API_USERNAME=
# When empty/unset, incoming API Basic authorization is disabled. When set, a password is required and all requests must authenticate.
INCOMING_API_PASSWORD=
FHIR_API_ENDPOINT=https://fhir.example.org/fhir
FHIR_FULL_URL_BASE=https://fhir.example.org/fhir
FHIR_API_USERNAME=
FHIR_API_PASSWORD=
MAX_FILE_SIZE_BYTES=52428800
FHIR_TIMEOUT_SECONDS=30
